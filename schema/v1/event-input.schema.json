{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-task-board.local/schema/v1/event-input.schema.json",
  "title": "AI Task Board v1 event input",
  "description": "Client event before server-assigned timestamp, source, sequence, and attempt metadata.",
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "$ref": "#/$defs/id" },
    "event": { "type": "string", "minLength": 1, "maxLength": 64 },
    "task_id": { "$ref": "#/$defs/id" },
    "project_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "parent_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "agent": { "type": "string", "minLength": 1, "maxLength": 100 },
    "model": { "type": ["string", "null"], "maxLength": 200 },
    "title": { "type": ["string", "null"], "maxLength": 200 },
    "step": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
    "plan": {
      "type": ["array", "null"],
      "maxItems": 20,
      "items": { "$ref": "#/$defs/planStep" }
    },
    "progress": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "tokens": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "input": { "type": "integer", "minimum": 0 },
            "output": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      ]
    },
    "reason": { "type": ["string", "null"], "maxLength": 500 },
    "summary": { "type": ["string", "null"], "maxLength": 500 },
    "error": { "type": ["string", "null"], "maxLength": 500 },
    "ts": { "type": "string", "format": "date-time" }
  },
  "required": ["event_id", "event", "task_id"],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "description": "A UUID or ULID generated by the client/bridge.",
      "pattern": "^(?:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|[0-9A-HJKMNP-TV-Z]{26})$"
    },
    "planStep": {
      "type": "object",
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 200 },
        "status": { "enum": ["pending", "active", "done"] }
      },
      "required": ["text", "status"],
      "additionalProperties": false
    }
  }
}
