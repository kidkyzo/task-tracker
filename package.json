{
  "name": "ai-task-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "build": "tsc -p tsconfig.node.json && node scripts/next.mjs build",
    "start": "npm run build && node scripts/next.mjs start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build:node && node --test \"dist/test/**/*.test.js\"",
    "build:node": "tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format:check": "prettier --check \"{app,server,integrations,test}/**/*.{ts,tsx}\" \"app/**/*.css\" \"proxy.ts\" \"next.config.mjs\" \"scripts/**/*.mjs\" \".agents/plugins/**/*.{json,mjs,md}\" \"*.js\" \"*.json\" \"schema/**/*.json\" \".github/**/*.yml\"",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run build && node --test \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "next": "^16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "10.12.0",
    "globals": "16.5.0",
    "prettier": "3.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
